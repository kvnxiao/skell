# When a .zwc is newer than its source, zsh loads it instead. A stale file can
# therefore run old code.
*.zwc

# SKELL_DATA_DIR may point at the clone. The store contains every recorded
# command.
history.tsv

# Each process writes its ranked dump, completion record, or bash scratch file
# under the shell name and process ID. A killed shell may leave the file behind.
rank-*-*.tsv
complete-*-*.tsv
scratch-*-*.hist

# migrate-atuin.sh stages a conversion beside its target. A killed run may
# leave the staged file behind.
history.tsv.*

# macOS and Windows write these into any directory a file manager opens.
.DS_Store
Thumbs.db
